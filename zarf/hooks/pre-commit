#!/usr/bin/env bash
# zarf/hooks/pre-commit
#
# Blocks commits when .docs/arch/ files are stale relative to staged source files.
# Install: make install-hooks
#
# Convention-based domain extraction (no hardcoded map):
#   business/domain/FOObus/**  →  .docs/arch/FOO-backend.md
#   app/domain/FOOapp/**       →  .docs/arch/FOO-backend.md
#   api/services/frontend/web/src/views/FOOBoardView.vue  →  .docs/arch/FOO-frontend.md
#   api/services/frontend/web/src/router/**  →  .docs/arch/views-frontend.md

set -euo pipefail

ARCH_DIR=".docs/arch"
STALE=()
NEW=()

# Batch arch freeze: reject any staged .docs/arch/ changes when a batch-beads
# run has set BATCH_ARCH_FROZEN=1. Arch regeneration happens once at batch end;
# workers must not touch arch docs mid-batch.
if [[ "${BATCH_ARCH_FROZEN:-0}" == "1" ]]; then
    frozen_touched=$(git diff --cached --name-only -- "$ARCH_DIR" || true)
    if [[ -n "$frozen_touched" ]]; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║  ⚠  BATCH_ARCH_FROZEN=1 — .docs/arch/ edits blocked.    ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo ""
        echo "  A batch-beads run is in progress. Arch docs are regenerated"
        echo "  once at batch end; mid-batch edits cause merge noise."
        echo ""
        echo "  Staged arch files:"
        printf '    %s\n' $frozen_touched
        echo ""
        echo "  Unstage with: git restore --staged .docs/arch/"
        echo ""
        exit 1
    fi
fi

# Batch branch enforcement: when batch-beads sets BATCH_EXPECTED_BRANCH, refuse
# commits on any other branch. Catches workers that drift out of their worktree
# (e.g., via absolute paths or `cd` into the parent repo).
if [[ -n "${BATCH_EXPECTED_BRANCH:-}" ]]; then
    actual_branch=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$actual_branch" != "$BATCH_EXPECTED_BRANCH" ]]; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║  ⚠  BATCH_EXPECTED_BRANCH mismatch — commit refused.    ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo ""
        echo "  Expected branch: $BATCH_EXPECTED_BRANCH"
        echo "  Actual branch:   $actual_branch"
        echo ""
        echo "  A batch-beads worker is committing outside its worktree."
        echo "  Stay inside your worktree — never \`cd\` into the parent repo,"
        echo "  never use absolute paths to /Users/casebrophy/personal/planner."
        echo ""
        exit 1
    fi
fi

# mtime: cross-platform file modification time (macOS + Linux)
mtime() {
    stat -f%m "$1" 2>/dev/null || stat -c%Y "$1" 2>/dev/null || echo 0
}

# check_arch: appends arch_name to STALE if older than source, or NEW if arch doesn't exist yet.
check_arch() {
    local arch_name="$1"
    local source_file="$2"
    local arch_path="$ARCH_DIR/${arch_name}.md"

    if [[ ! -f "$arch_path" ]]; then
        NEW+=("$arch_name")  # new domain — remind but don't block
        return 0
    fi

    local arch_mt source_mt
    arch_mt=$(mtime "$arch_path")
    source_mt=$(mtime "$source_file")

    if [[ "$source_mt" -gt "$arch_mt" ]]; then
        STALE+=("$arch_name")
    fi
}

# Process each staged file
while IFS= read -r file; do
    [[ -f "$file" ]] || continue  # skip deletions/renames

    # ── Backend ───────────────────────────────────────────────────────────────
    # Only structural files affect arch accuracy: model, interface, route, filter, order.
    # Implementation-only changes (handler logic, SQL query tweaks) don't invalidate arch docs.
    if [[ "$file" =~ ^(business|app)/domain/([a-z]+)(bus|app)/ ]]; then
        base=$(basename "$file")
        case "$base" in
            model.go|route.go|filter.go|order.go|*bus.go|*app.go) ;;
            *) continue ;;
        esac
        check_arch "${BASH_REMATCH[2]}-backend" "$file"
        continue
    fi

    # ── Frontend ──────────────────────────────────────────────────────────────
    # Views: strip view-type suffixes (Board, Detail, Queue, View) then lowercase
    # to derive domain, mapping to domain-specific frontend arch docs.
    if [[ "$file" =~ ^api/services/frontend/web/src/views/.*\.(ts|vue)$ ]]; then
        base=$(basename "$file")
        name="${base%.*}"

        domain=$(printf '%s' "$name" \
            | sed 's/View$//' \
            | sed 's/Board$//' \
            | sed 's/Detail$//' \
            | sed 's/Queue$//' \
            | tr '[:upper:]' '[:lower:]')

        # Handle plurals: prefer singular arch file (e.g., NotesBoardView → note-frontend)
        if [[ ! -f "$ARCH_DIR/${domain}-frontend.md" && -f "$ARCH_DIR/${domain%s}-frontend.md" ]]; then
            domain="${domain%s}"
        fi

        check_arch "${domain}-frontend" "$file"
        continue
    fi

    # Router changes map to the shared views/navigation arch doc.
    if [[ "$file" =~ ^api/services/frontend/web/src/router/.*\.ts$ ]]; then
        check_arch "views-frontend" "$file"
        continue
    fi

    # Composables: derive domain from subdirectory name.
    # e.g., composables/tasks/useTaskNotes.ts → task
    # Components are excluded — they're mostly presentation and rarely affect arch doc accuracy.
    if [[ "$file" == api/services/frontend/web/src/composables/* ]]; then
        domain="${file#api/services/frontend/web/src/composables/}"
        domain="${domain%%/*}"
        # Skip files at the root of components/composables (no subdirectory)
        [[ "$domain" == *.* ]] && continue
        # Strip trailing 's' for plural dirs (tasks → task, contexts → context)
        domain="${domain%s}"
        # Skip shared/layout — no domain arch doc
        [[ "$domain" =~ ^(shared|layout|tag)$ ]] && continue
        # Normalize hyphenated names (calendar-events → calendar)
        domain="${domain%%-*}"
        check_arch "${domain}-frontend" "$file"
        continue
    fi

    # Structural paths: types, stores, services affect domain-specific arch docs.
    if [[ "$file" =~ ^api/services/frontend/web/src/(types|stores|services)/.*\.(ts|vue)$ ]]; then
        base=$(basename "$file")
        name="${base%.*}"  # strip extension

        # Derive domain:
        #   1. strip common prefixes/suffixes
        #   2. extract first PascalCase/camelCase word
        #   3. lowercase
        domain=$(printf '%s' "$name" \
            | sed 's/^use//' \
            | sed 's/Store$//' \
            | sed 's/Service$//' \
            | sed 's/View$//' \
            | sed 's/^\([A-Za-z][a-z]*\).*/\1/' \
            | tr '[:upper:]' '[:lower:]')

        # Skip shared utilities with no arch file and no reasonable domain mapping
        [[ "$domain" =~ ^(create|client|router|index|main|app|toast|pagination|polling|query|search|media)$ ]] && continue
        check_arch "${domain}-frontend" "$file"
    fi

done < <(git diff --cached --name-only)

# ── Generated TypeScript types staleness check ────────────────────────────────
# If any Go source that feeds codegen is staged, regenerate and block if dirty.
CODEGEN_SOURCES=(
    "business/domain/clarificationbus/options.go"
    "business/types/clarificationkind/clarificationkind.go"
)
NEEDS_REGEN=false
for src in "${CODEGEN_SOURCES[@]}"; do
    if git diff --cached --name-only | grep -q "^${src}$"; then
        NEEDS_REGEN=true
        break
    fi
done

if [[ "$NEEDS_REGEN" == "true" ]]; then
    make generate > /dev/null 2>&1
    if ! git diff --exit-code api/services/frontend/web/src/types/generated/ > /dev/null 2>&1; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║  ⚠  Generated TypeScript types are stale.               ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo ""
        echo "  Run: make generate"
        echo "  Then: git add api/services/frontend/web/src/types/generated/"
        echo ""
        exit 1
    fi
fi

# ── Report ────────────────────────────────────────────────────────────────────

# Warn about new domains (non-blocking)
if [[ ${#NEW[@]} -gt 0 ]]; then
    echo ""
    echo "  ℹ  New domain(s) detected — no arch file yet:"
    while IFS= read -r name; do
        if [[ "$name" == *-backend ]]; then
            echo "     /go-arch ${name%-backend}"
        else
            echo "     /vue-arch ${name%-frontend}"
        fi
    done < <(printf '%s\n' "${NEW[@]}" | sort -u)
    echo ""
fi

# Block on stale arch files
[[ ${#STALE[@]} -eq 0 ]] && exit 0

echo "╔══════════════════════════════════════════════════════════╗"
echo "║  ⚠  Stale arch docs detected. Update before committing. ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo ""
while IFS= read -r name; do
    if [[ "$name" == *-backend ]]; then
        echo "  /go-arch ${name%-backend}"
    else
        echo "  /vue-arch ${name%-frontend}"
    fi
done < <(printf '%s\n' "${STALE[@]}" | sort -u)
echo ""
echo "  After updating, stage the arch files and commit again:"
echo "  git add .docs/arch/ && git commit"
echo ""
exit 1

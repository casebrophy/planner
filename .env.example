# Local development — copy to .env and fill in values
# Makefile auto-includes .env via -include .env

# Database (Docker maps Postgres to 5433 locally, not 5432)
PLANNER_DB_HOST=localhost
PLANNER_DB_PORT=5433
PLANNER_DB_USER=planner
PLANNER_DB_PASSWORD=planner
PLANNER_DB_NAME=planner
PLANNER_DB_DISABLE_TLS=true

# Auth
PLANNER_AUTH_API_KEY=devkey123

# SMTP (disabled by default)
PLANNER_SMTP_ENABLED=false
PLANNER_SMTP_DOMAIN=localhost

# Claude CLI
PLANNER_CLAUDE_CLI_PATH=claude
PLANNER_CLAUDE_MODELS=haiku,sonnet,opus

# --- Secrets (put these in .secrets.env, not here) ---
# PLANNER_API_KEY=<openssl rand -hex 32>
# PLANNER_DB_PASSWORD=<openssl rand -hex 24>
# PLANNER_AUTH_PASSWORD=<choose a password>
